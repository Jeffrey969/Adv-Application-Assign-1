# Sprint 2 Implementation
# This program reads a sentence about coins and converts it to a dollar value.

# How much each coin is worth
values = {
    "penny": 0.01,
    "nickel": 0.05,
    "dime": 0.10,
    "quarter": 0.25
}

def money_from_sentence(text):
    groups = text.split("and")
    total_amount = 0

    for g in groups:
        g = g.strip()
        parts = g.split()

        number = int(parts[0])

        coin = parts[1].lower()

        #fixes penny issue
        if coin == "pennies":
            coin = "penny"
        elif coin.endswith("s"):
            coin = coin[:-1]

        total_amount += number * values[coin]

    return round(total_amount, 2)

print("Coin Converter")
user_text = input("Type something: ")
answer = money_from_sentence(user_text)
print("Final dollar amount:", answer)
